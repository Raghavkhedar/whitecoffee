# Secrets (never commit)
keystore.properties
**/keystore.properties
*.jks
*.keystore
**/local.properties
admin/.env.local
**/.env.local
firebase/functions/*.local
# Service-account keys (belt-and-suspenders — never commit these anywhere)
**/serviceAccount*.json
**/*-serviceaccount*.json
**/wckey.json

# Android / Gradle
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
android/local.properties
# Build artifacts — regenerable, keep them out of git
*.apk
*.aab
android/app/debug/
android/app/release/

# One-off design handoff bundle — not part of the build
android/WhiteCoffe.zip

# Node / Next.js
admin/node_modules/
admin/.next/
admin/out/
firebase/functions/node_modules/

# Firebase
.firebase/
firebase-debug.log
firebase-debug.*.log
firestore-debug.log

# Graphify (regenerated at root)
graphify-out/

# Claude Code local session state — worktrees and dev-server launch config,
# never part of the project itself.
.claude/worktrees/
.claude/launch.json

# Legacy-status migration plan/backup files (firebase/functions/scripts/migrateLegacyLeaveStatuses.js).
# They hold full employee attendance docs — never commit them, wherever the script was run from.
migration-out/
